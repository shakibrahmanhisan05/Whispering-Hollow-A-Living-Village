# ─────────────────────────────────────────────────────────────────────────────
# Whispering Hollow — environment variables
#
# Copy this file to `.env.local` and fill in your values.
#   cp .env.example .env.local
#
# EVERY VARIABLE BELOW IS OPTIONAL.
# With no configuration at all the game runs fully offline: progress, settings
# and screenshots are persisted to localStorage / IndexedDB instead of Firebase,
# and multiplayer presence is disabled. Add credentials to light those up.
# ─────────────────────────────────────────────────────────────────────────────


# ── Firebase (client SDK) ────────────────────────────────────────────────────
# Firebase console → Project settings → General → "Your apps" → Web app config.
# These are public by design — access is controlled by security rules, not secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL — Firebase console → Realtime Database → copy the URL.
# Format: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
# Required only if you want multiplayer presence.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Optional: Google Analytics for Firebase
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ── Firebase App Check (reCAPTCHA v3) ────────────────────────────────────────
# Firebase console → App Check → Apps → register web app with reCAPTCHA v3.
# Leave blank to disable App Check entirely.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Local dev only: App Check debug token. Set to `true` to have the SDK print a
# token you then register under App Check → Apps → Manage debug tokens.
# NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=true


# ── Feature flags ────────────────────────────────────────────────────────────
# Ambient multiplayer presence (ghost avatars). Requires DATABASE_URL above.
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false

# Proximity voice chat (WebRTC, Firestore signalling). Experimental.
NEXT_PUBLIC_ENABLE_VOICE_CHAT=false

# Force the WebGPU renderer path when the browser reports support.
# Off by default — see "Known limitations" in README.md.
NEXT_PUBLIC_ENABLE_WEBGPU=false


# ── Telemetry ────────────────────────────────────────────────────────────────
# Sentry → Project → Settings → Client Keys (DSN). Blank = Sentry disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Vercel Analytics needs no token when deployed on Vercel — enable it in the
# Vercel dashboard (Project → Analytics). Set to `false` to strip the script.
NEXT_PUBLIC_ENABLE_ANALYTICS=true


# ── Seed script (server-side only — NEVER prefix with NEXT_PUBLIC_) ──────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either point at the downloaded JSON file…
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# …or paste the whole JSON as a single-line string (useful in CI):
# FIREBASE_SERVICE_ACCOUNT_JSON=
